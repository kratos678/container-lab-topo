# Route-reflector: control-plane only, not in the MPLS data path, so no
# ldpd. Still runs OSPF for IGP reachability to every PE loopback.
zebra=yes
bgpd=yes
ospfd=yes
staticd=yes

watchfrr_enable=yes
vtysh_enable=yes

zebra_options="   -A 127.0.0.1 -M snmp"
bgpd_options="    -A 127.0.0.1 -M snmp"
ospfd_options="   -A 127.0.0.1 -M snmp"
staticd_options=" -A 127.0.0.1"
